# Throwaway credentials for the integration tier — they match
# docker-compose.test.yml and are committed on purpose. Never reuse them
# anywhere real.
#
#   docker compose -f docker-compose.test.yml up -d
#   npm run test:integration

LOG_LEVEL=error
OTEL_SDK_DISABLED=true

# --- Postgres (docker-compose.test.yml: postgres) ---
PGHOST=localhost
PGPORT=54329
PGUSER=portal
PGPASSWORD=portal_test
PGDATABASE=portal_test

# --- MSSQL (docker-compose.test.yml: mssql) ---
MSSQL_HOST=localhost
MSSQL_PORT=14339
MSSQL_USER=sa
MSSQL_PASSWORD=Portal_Test1!
MSSQL_DATABASE=master
MSSQL_ENCRYPT=true
MSSQL_TRUST_SERVER_CERTIFICATE=true

# --- S3 (docker-compose.test.yml: minio) ---
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=portaltest
AWS_SECRET_ACCESS_KEY=portaltest
S3_BUCKET=portal-test
S3_ENDPOINT=http://localhost:9009
