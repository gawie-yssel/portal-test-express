# Copy to .env for local development (.env is gitignored).

PORT=3000

# --- Postgres ---
# Either set a full connection string...
DATABASE_URL=
# ...or the discrete parts (used when DATABASE_URL is empty):
PGHOST=
PGPORT=5432
PGUSER=
PGPASSWORD=
PGDATABASE=
# Set to "true" for managed/SSL Postgres (uses rejectUnauthorized: false).
PGSSL=false

# --- MSSQL (SQL Server) ---
# Either set a full connection string — ADO "Key=Value;" form only, e.g.
# Server=localhost,1433;Database=mydb;User Id=sa;Password=secret;Encrypt=true
# (an "mssql://" URI is NOT supported by the driver and will not parse)...
MSSQL_CONNECTION_STRING=
# ...or the discrete parts (used when MSSQL_CONNECTION_STRING is empty):
MSSQL_HOST=
MSSQL_PORT=1433
MSSQL_USER=
MSSQL_PASSWORD=
MSSQL_DATABASE=
# TLS. Both default to "true", which connects to a dev server with a
# self-signed cert (e.g. the mcr.microsoft.com/mssql/server container) out of
# the box. Set MSSQL_TRUST_SERVER_CERTIFICATE=false against Azure SQL or any
# server with a properly trusted certificate — leaving it true accepts *any*
# certificate. These two apply to the discrete vars only; a connection string
# carries its own Encrypt / TrustServerCertificate keys.
MSSQL_ENCRYPT=true
MSSQL_TRUST_SERVER_CERTIFICATE=true

# --- S3 ---
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=
# For S3-compatible servers (MinIO, LocalStack, etc.). Leave empty for real AWS.
# When set, the client uses this URL and path-style addressing.
S3_ENDPOINT=

# --- Disk ---
# Absolute path to the mounted volume / attached disk to test.
DISK_PATH=

# --- Observability ---
# Console log verbosity: error | warn | info | debug
LOG_LEVEL=info
# Set to "true" to log truncated SQL text (never param values) and capture SQL
# params on Postgres/MSSQL telemetry spans. Off by default since SQL is user input.
LOG_SQL=false

# OpenTelemetry (traces + metrics over OTLP). Any standard OTEL_* var is honored.
OTEL_SERVICE_NAME=portal-test-express
# OTLP collector endpoint, e.g. http://localhost:4318. Leave empty if no collector.
OTEL_EXPORTER_OTLP_ENDPOINT=
# Set to "true" to disable OpenTelemetry entirely.
OTEL_SDK_DISABLED=false
